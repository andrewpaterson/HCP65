# Visual Studio
.vs/
*.VC.db
*.VC.opendb
*.suo
*.hcp65user
*.sdf
*.opensdf
*ipch
*.swp

# MSBuild output for every project and platform (Win32: Debug/Release, x64: x64/Debug, x64/Release)
[Dd]ebug/
[Rr]elease/
x64/

# Logs written by the emulator, the tester and the tests
Log.txt

# What HCP65-IDE and hcp65build write beside a solution (Output\<toolchain>\<configuration> and Listing\...), and what
# the emulator and the tests write
Output/
Listing/

# hcp65build -show-plain's plain command line and its lists of each project's sources
*.plain
*.units

# DeviceROM\MakeImages.ps1's ROM images
/DeviceROM/Images/

# Files the tests write
/HCP65-Emulator/TestHCP65Lib/TestHCP65Lib/Post/
/Tests/TestLibc65/TestLibc65/Post/

# KiCad's own files: backups, caches, autosaves, locks and local view settings
*-backups/
fp-info-cache
_autosave-*
*.lck
*.bak
*-bak
*.kicad_prl
temp-freerouting.dsn

# MkDocs build output (web.sh)
/Website/site/
/Website/.venv/

/Tests/TestLibc65/TestLibc65/Log_65C64.txt
/Tests/TestLibc65/TestLibc65/Log_816.txt
*.layout.user
*.hcp65workspace
