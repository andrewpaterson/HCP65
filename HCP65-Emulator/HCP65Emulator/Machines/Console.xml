<!-- The console: the Small Mainboard booting TestHCP65KernalConsole's card, whose boot.exe (HCP65/Console) shows what is -->
<!-- typed on the PS2 Board's keyboard on the terminal at the far end of the UART Board's RS232 port.  Files are -->
<!-- relative to this one. -->
<Mainboard Type="Small">
	<Processor Index="0">
		<Board Socket="3" Type="SD Card Board">
			<Card Socket="0" File="../../TestHCP65Lib/TestHCP65Lib/Output/ConsoleCard.img"/>
		</Board>
		<Board Socket="4" Type="UART Board"/>
		<Board Socket="16" Type="VIA Board">
			<Breakout Socket="0"/>
		</Board>
		<Board Socket="17" Type="PS2 Board"/>
		<Board Socket="18" Type="Memory Board"/>
		<Board Socket="19" Type="Sound Board"/>
	</Processor>
</Mainboard>
