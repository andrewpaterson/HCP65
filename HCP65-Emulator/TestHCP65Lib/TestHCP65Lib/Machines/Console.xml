<?xml version="1.0" encoding="utf-8"?>
<!-- TestHCP65KernalConsole's Small Mainboard: the system card, the Video Board (the console's text) and the PS2 Board, -->
<!-- with the test's keyboard in port 1.  Files are relative to this one; the test writes the card into Output. -->
<Mainboard Type="Small">
	<Processor Index="0">
		<Board Socket="3" Type="PS2 Board"/>
		<Board Socket="4" Type="SD Card Board">
			<Card Socket="2" File="../Output/SDCard.img"/>
		</Board>
		<Board Socket="16" Type="Video Board"/>
		<Board Socket="18" Type="Memory Board"/>
	</Processor>
</Mainboard>
