<?xml version="1.0" encoding="utf-8"?>
<!-- The kernal, \OS\OS.SYS: the bytes from $00FF00 (bank 0's stubs and vectors) to the end of bank 3, which the boot
     loader ROM (HCP65/Boot) reads into MPU RAM and jumps to.  bss after them may go up to the remap table.  Debugged on
     the boot loader it starts from, on the emulator's card. -->
<BuildConfigurations>
	<Configuration Name="Debug|HCP65C816" Toolchain="W65C816" Solution="Debug|Win32" BreakpointSpace="Kernel" Card="..\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\SDCard.img" CardPath="\OS\OS.SYS">
		<Load File="..\Boot\Output\HCP65C816\Release\Boot.rom" Address="0x0"/>
	</Configuration>
	<Configuration Name="Release|HCP65C816" Toolchain="W65C816" Solution="Release|Win32" BreakpointSpace="Kernel" Card="..\HCP65-Emulator\TestHCP65Lib\TestHCP65Lib\Output\SDCard.img" CardPath="\OS\OS.SYS">
		<Load File="..\Boot\Output\HCP65C816\Release\Boot.rom" Address="0x0"/>
	</Configuration>
</BuildConfigurations>
