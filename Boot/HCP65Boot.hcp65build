<?xml version="1.0" encoding="utf-8"?>
<!-- The boot loader, the MPU ROM: linked to run from MPU RAM banks 4 and 5 (Text), where its start up copies it from
     the same offsets in the ROM, with bank 0's stubs and vectors at $FF00.  bss may go up to the heap in bank 6. -->
<BuildConfigurations>
	<Configuration Name="Debug|HCP65C816" Toolchain="W65C816" Solution="Debug|Win32" BreakpointSpace="Kernel">
	</Configuration>
	<Configuration Name="Release|HCP65C816" Toolchain="W65C816" Solution="Release|Win32" BreakpointSpace="Kernel">
	</Configuration>
</BuildConfigurations>
